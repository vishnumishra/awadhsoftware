# Copy to .env.local (never commit real values).

# Formspree form ID — contact form + lead-magnet emails post here.
# Create a form at https://formspree.io and paste the ID (the part after /f/).
NEXT_PUBLIC_FORMSPREE_ID=

# Optional: HTTPS endpoint for the "Awadh AI" chatbot. The site POSTs
#   { messages: [{ role: 'user' | 'assistant', content: string }], lang: 'en' | 'hi' }
# and expects JSON { reply: string }. Until this is set, the chatbot answers with a
# WhatsApp hand-off instead of calling a model.
NEXT_PUBLIC_CHAT_ENDPOINT=

# Optional: Google Tag Manager container (GTM-XXXXXXX) for ads / analytics tracking.
NEXT_PUBLIC_GTM_ID=
